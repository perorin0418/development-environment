# compose.yaml が参照する環境変数のサンプル。
# コピーして .env として使う: cp .env.example .env
#
# 重要: docker compose は WSL Debian のシェル内から実行するため
# (Rancher Desktop の docker クライアントは \\wsl$\... のような UNC パスを
# bind mount のソースとして解釈できないため。詳細は ../README.md 参照)、
# ここに指定するのは WSL Debian から見えるネイティブパスであること。
# Windows 側の UNC パス(\\wsl$\Debian\...)は指定しないこと。
WSL_MOUNT_SOURCE=/workspace/dev-container

# 以下は認証情報・設定を含むディレクトリ/ファイルを WSL Debian 側に
# 個別に永続化するためのマウント元パス。すべて WSL Debian 側のネイティブパス
# であること。ディレクトリはマウント前に `mkdir -p` で、ファイルはマウント前に
# `touch` で作成しておくこと(存在しないとディレクトリとして作成されてしまう)。
# 指定しない/存在しない場合、コンテナ削除時に該当データが消え、再ログイン等が
# 必要になる。

# ~/.jcode: jcode login の認証情報 (auth.json 等)
WSL_JCODE_HOME=/workspace/dev-container-jcode-home
# ~/.config/gh: gh auth login の認証情報
WSL_GH_CONFIG_HOME=/workspace/dev-container-gh-config
# ~/.claude: Claude Code CLI の認証情報 (.credentials.json 等)
WSL_CLAUDE_HOME=/workspace/dev-container-claude-home
# ~/.ssh: SSH 鍵
WSL_SSH_HOME=/workspace/dev-container-ssh
# ~/.gitconfig: git のユーザー設定 (ファイル)
WSL_GITCONFIG_FILE=/workspace/dev-container-gitconfig
# ~/.npmrc: npm の認証・レジストリ設定 (ファイル)
WSL_NPMRC_FILE=/workspace/dev-container-npmrc

# WSL Debian 側の実行ユーザーと UID/GID を揃えたい場合に指定する。
# WSL Debian のシェルで `id -u` / `id -g` を実行して値を確認する。
USER_UID=1000
USER_GID=1000
