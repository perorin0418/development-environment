# compose.yaml が参照する環境変数のサンプル。
# コピーして .env として使う: cp .env.example .env
# (setup-dev-container.bat/.sh を実行すると自動的にコピーされ、下記の
#  $HOME はその時点の WSL Debian ユーザーの実ホームディレクトリに
#  自動展開される。手動で cp する場合は自分で書き換えること)
#
# 重要: docker compose は WSL Debian のシェル内から実行するため
# (Rancher Desktop の docker クライアントは \\wsl$\... のような UNC パスを
# bind mount のソースとして解釈できないため。詳細は ../README.md 参照)、
# ここに指定するのは WSL Debian から見えるネイティブパスであること。
# Windows 側の UNC パス(\\wsl$\Debian\...)は指定しないこと。
# また、/workspace のような root 所有のトップレベルディレクトリを直接
# 指定すると、一般ユーザーでの mkdir/chown が Permission denied になるため、
# 既定値はユーザーのホームディレクトリ配下(書き込み権限を持つ場所)にしている。
WSL_MOUNT_SOURCE=$HOME/workspace/dev-container

# 以下は認証情報・設定を含むディレクトリ/ファイルを WSL Debian 側に
# 個別に永続化するためのマウント元パス。すべて WSL Debian 側のネイティブパス
# であること。ディレクトリはマウント前に `mkdir -p` で、ファイルはマウント前に
# `touch` で作成しておくこと(存在しないとディレクトリとして作成されてしまう)。
# 指定しない/存在しない場合、コンテナ削除時に該当データが消え、再ログイン等が
# 必要になる。

# ~/.jcode-data ($JCODE_HOME): jcode login の認証情報 (auth.json 等)
WSL_JCODE_HOME=$HOME/workspace/dev-container-jcode-home
# ~/.config/gh: gh auth login の認証情報
WSL_GH_CONFIG_HOME=$HOME/workspace/dev-container-gh-config
# ~/.claude: Claude Code CLI の認証情報 (.credentials.json 等)
WSL_CLAUDE_HOME=$HOME/workspace/dev-container-claude-home
# ~/.ssh: SSH 鍵
WSL_SSH_HOME=$HOME/workspace/dev-container-ssh
# ~/.config/git: git のユーザー設定 (ディレクトリ)
WSL_GIT_CONFIG_HOME=$HOME/workspace/dev-container-git-config
# ~/.npmrc: npm の認証・レジストリ設定 (ファイル)
WSL_NPMRC_FILE=$HOME/workspace/dev-container-npmrc
# ~/AGENTS.md: jcode のグローバル指示ファイル (ファイル)
WSL_AGENTS_MD_FILE=$HOME/workspace/dev-container-agents-md
# ~/.aws: AWS CLI の認証情報・設定 (ディレクトリ)
WSL_AWS_HOME=$HOME/workspace/dev-container-aws-home
# ~/.config/herdr: herdr の設定・セッション状態 (config.toml, session.json 等)
WSL_HERDR_CONFIG_HOME=$HOME/workspace/dev-container-herdr-config
# ~/.local/state/herdr: herdr のエージェント検出状態 (agent-detection/ 配下)
WSL_HERDR_STATE_HOME=$HOME/workspace/dev-container-herdr-state

# ホストの全ドライブ(Windows の C:, D: 等)をコンテナにマウントするための
# マウント元。WSL は起動時にホストの各ドライブを自動的に /mnt/c, /mnt/d ...
# へマウント済みのため、通常は変更不要(既定値の /mnt をそのまま使う)。
# start-dev-container.bat/stop-dev-container.bat の実行時に
# scripts/generate-host-drives-compose.sh がこの値の配下を動的検出し、
# ドライブごとの個別バインドマウント定義(compose.host-drives.yaml)を
# 生成する(/mnt 丸ごとのバインドマウントは Rancher Desktop 側の
# アンマウント処理が失敗する既知の問題があるため行わない)。
# 上記の永続化用ディレクトリ/ファイルとは異なり、setup-dev-container.sh の
# mkdir/chown 対象には含めていない(/mnt は WSL がシステムとして管理する
# 既存のマウントポイントであり、再帰的な chown を行うとホストの全ドライブに
# 影響してしまうため)。
# 詳細は docs/BACKGROUND.md 参照。
WSL_HOST_DRIVES_SOURCE=/mnt

# WSL Debian 側の実行ユーザーと UID/GID を揃えたい場合に指定する。
# WSL Debian のシェルで `id -u` / `id -g` を実行して値を確認する。
USER_UID=1000
USER_GID=1000
